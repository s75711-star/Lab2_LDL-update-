<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="[ Penganalisis Peribadi ]"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nama Penuh:"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editNama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="cth: Ahmad bin Ali"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tarikh Lahir:"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editTarikh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="2000-05-15"
        android:inputType="date"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnAnalisis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ANALISIS SAYA" />

</LinearLayout>